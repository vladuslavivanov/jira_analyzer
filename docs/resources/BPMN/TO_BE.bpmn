      <bpmn:outgoing>Flow_11tw7ck</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendJiraRequest" name="Получить информацию о каждой задаче из набора">
      <bpmn:incoming>Flow_11tw7ck</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1v1qpsc" name="Сформировать отчет&#10;по всем задачам">
