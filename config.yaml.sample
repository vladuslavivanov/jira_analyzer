# Jira AI Analyzer Configuration
# SECURITY: All provider values must be set - no defaults exist
# This configuration uses internal/self-hosted services only

llm:
  provider_type: openai-compatible
  api_key: your-internal-api-key  # Required - no default
  base_url: http://localhost:8000/v1  # Required - internal URL only
  model: your-model-name  # Required - no external model names
  temperature: 0.7

logging:
  level: INFO
  log_llm_prompts: false

jira:
  use_mock: true
  mock_dataset_path: data/jira_mock_data.json

i18n:
  language: en
