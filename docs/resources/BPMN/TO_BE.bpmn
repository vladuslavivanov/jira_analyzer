  <bpmn:process id="Process_ToBe_JiraAnalyzer" name="TO-BE: Анализ задач через Jira Analyzer" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1vrqvuj" name="Jira Analyzer">
        <bpmn:flowNodeRef>Task_SendJiraRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1v1qpsc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowAnalysisResults</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0ut6obu" name="Пользователь">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenAnalyzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetJql</bpmn:flowNodeRef>
