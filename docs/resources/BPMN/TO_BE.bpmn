        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Запрос на анализ задач">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OpenAnalyzer" name="Определить набор задач для анализа">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_0q00f9e</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetJql" name="Запустить анализ для выбранного набора задач">
