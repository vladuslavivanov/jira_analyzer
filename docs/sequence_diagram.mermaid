sequenceDiagram
    autonumber

    actor User

    box Streamlit Web Service
        participant WebUI as Streamlit Web Service<br>(UI + integrated Controller)
    end

    box Analysis Service
        participant AnalysisService as Analysis Service
        participant Analyzer as Analyzer
        participant TasksRepository as Tasks Repository
    end

    box Task Tracker (Jira)
        participant TaskTrackerAdapter as Task Tracker Adapter
        participant JiraClient as Jira Client
    end

    participant MockJira@{ "type": "boundary" } as Mock Jira Service
    participant JsonDataset@{ "type" : "collections" } as JSON Dataset

    box Storage
        participant AnalysisResultRepo as Analysis Result<br> Repository
        participant ResultStorage@{ "type" : "database" } as Analysis Result<br> Storage (SQLite)
    end

    box LLM Provider
        participant LLMClient as LLM Client
    end

    participant LLMProvider@{ "type": "boundary" } as External LLM Provider

    %% User initiates analysis
    User->>WebUI: Request analysis of Jira tickets<br>(JQL query or JSON dataset)

    WebUI->>AnalysisService: Delegate analysis task

    %% Determine scope based on request type
    alt Request uses JQL
        AnalysisService->>TasksRepository: Request data for analysis
        TasksRepository->>TaskTrackerAdapter: Query task metadata (JQL)
        TaskTrackerAdapter->>JiraClient: Forward request
        JiraClient->>MockJira: Call Jira API (or mock)
        MockJira->>JsonDataset: Read JSON file
        break when broken JSON dataset
            AnalysisService-->>User: Indicates Error With Jira Service
        end
        JsonDataset->>MockJira: Return data
        MockJira-->>JiraClient: Return task list metadata
        JiraClient-->>TaskTrackerAdapter: Return metadata
        TaskTrackerAdapter-->>TasksRepository: Return task IDs & basic info
        TasksRepository-->>AnalysisService: Return requested data

        AnalysisService->>AnalysisResultRepo: Check which tasks are already analysed
        AnalysisResultRepo-->>AnalysisService: Return list of analysed task IDs

        AnalysisService->>TasksRepository: Request data for analysis
        TasksRepository->>TaskTrackerAdapter: Fetch full data for remaining tasks
        TaskTrackerAdapter-->>TasksRepository: Return remaining tasks data
        TasksRepository-->>AnalysisService: Return requested data

    else Request uses JSON dataset
        AnalysisService->>TasksRepository: Request data for analysis
        TasksRepository->>JsonDataset: Read JSON file
        break when broken JSON dataset
            AnalysisService-->>User: Indicates Error With JSON file
        end
        JsonDataset->>TasksRepository: Return data
        AnalysisService->>AnalysisResultRepo: Add tasks as pending
        AnalysisResultRepo->>ResultStorage: Store pending tasks
        ResultStorage->>AnalysisResultRepo: Confirm storage
        AnalysisResultRepo-->>AnalysisService: Pending tasks ready
    end

    loop For each pending task (or batch)
        AnalysisService->>Analyzer: Start analysis for task

        Analyzer->>Analyzer: Split multi‑criteria request<br/>to single-criteria requests

        par Asynchronous parallel LLM calls (respecting rate limits)
            Analyzer->>LLMClient: Request LLM for analysis
            LLMClient-->>LLMProvider: Call LLM
            LLMProvider-->>LLMClient: Return partial result
            Note over LLMClient,LLMProvider: Queue, rate-limit, retry, timeout
            LLMClient-->>Analyzer: Return anslysis result
        end

        Analyzer->>Analyzer: Join single‑criteria results<br/> into multi‑criteria result
        Analyzer-->>AnalysisService: Return complete<br/> analysis for task

        AnalysisService->>AnalysisResultRepo: Save intermediate result (update storage)
        AnalysisResultRepo->>ResultStorage: Store/update analysis result
        ResultStorage->>AnalysisResultRepo: Confirm storage
        AnalysisResultRepo-->>AnalysisService: Save confirmed
    end
    AnalysisService-->>WebUI: Indicates tasks analysis completion

    WebUI->>AnalysisResultRepo: Query ready results
    AnalysisResultRepo->>ResultStorage: Retrieve results
    ResultStorage-->>AnalysisResultRepo: Return results
    AnalysisResultRepo-->>WebUI: Return formatted results
    WebUI->>WebUI: Aggregates results
    WebUI-->>User: Display linter report
