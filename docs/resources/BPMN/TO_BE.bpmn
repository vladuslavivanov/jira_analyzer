      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShowAnalysisResults" name="Сохранить результаты">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExportReport" name="Экспортировать отчет">
      <bpmn:incoming>Flow_0pz0j82</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Отчет экспортирован">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_OpenAnalyzer" />
    <bpmn:sequenceFlow id="Flow_0q00f9e" sourceRef="Task_OpenAnalyzer" targetRef="Task_SetJql" />
