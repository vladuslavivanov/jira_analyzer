<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_AsIs_JiraAudit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.47.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_AsIs_ManualJiraAudit" name="AS-IS: Ручной аудит задач в Jira" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Jira" name="Jira">
        <bpmn:flowNodeRef>Task_ShowIssueList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowIssueCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveComment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Task_OpenJira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetFilter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteComments</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HasProblems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreIssues</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Нужно проверить качество задач">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OpenJira" name="Открыть Jira">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetFilter" name="Выбрать проект / фильтр задач">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShowIssueList" name="Показать список задач">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReadIssue" name="Открыть и прочитать задачу">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShowIssueCard" name="Показать карточку задачи">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckQuality" name="Проверить описание, DoD и декомпозицию">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasProblems" name="Есть замечания?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_8_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_WriteComments" name="Зафиксировать замечания вручную">
      <bpmn:incoming>Flow_8_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SaveComment" name="Сохранить замечание в Jira">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MoreIssues" name="Есть еще задачи?">
      <bpmn:incoming>Flow_8_No</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareReport" name="Подготовить отчет вручную">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Ручной аудит завершен">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_OpenJira" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_OpenJira" targetRef="Task_SetFilter" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_SetFilter" targetRef="Task_ShowIssueList" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ShowIssueList" targetRef="Task_ReadIssue" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadIssue" targetRef="Task_ShowIssueCard" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ShowIssueCard" targetRef="Task_CheckQuality" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CheckQuality" targetRef="Gateway_HasProblems" />
    <bpmn:sequenceFlow id="Flow_8_Yes" name="Да" sourceRef="Gateway_HasProblems" targetRef="Task_WriteComments" />
    <bpmn:sequenceFlow id="Flow_8_No" name="Нет" sourceRef="Gateway_HasProblems" targetRef="Gateway_MoreIssues" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_WriteComments" targetRef="Task_SaveComment" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SaveComment" targetRef="Gateway_MoreIssues" />
    <bpmn:sequenceFlow id="Flow_11" name="Да" sourceRef="Gateway_MoreIssues" targetRef="Task_ReadIssue" />
    <bpmn:sequenceFlow id="Flow_12" name="Нет" sourceRef="Gateway_MoreIssues" targetRef="Task_PrepareReport" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareReport" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_AsIs_ManualJiraAudit">
      <bpmndi:BPMNShape id="Lane_Jira_di" bpmnElement="Lane_Jira" isHorizontal="true">
        <dc:Bounds x="130" y="290" width="2060" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
