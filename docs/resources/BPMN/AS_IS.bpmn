    <bpmn:sequenceFlow id="Flow_8_Yes" name="Да" sourceRef="Gateway_HasProblems" targetRef="Task_WriteComments" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_WriteComments" targetRef="Gateway_MoreIssues" />
    <bpmn:startEvent id="StartEvent_1" name="Запрос на анализ задач">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SetFilter" name="Определить набор задач для анализа">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReadIssue" name="Открыть страницу с описанием задачи">
      <bpmn:incoming>Flow_06t9eet</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckQuality" name="Проанализировать задачу по критериям">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_HasProblems" name="Есть замечания?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_8_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ShowIssueList" name="Показать список задач">
