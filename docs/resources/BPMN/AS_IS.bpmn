    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReadIssue" targetRef="Task_ShowIssueCard" />
    <bpmn:sequenceFlow id="Flow_8_No" name="Нет" sourceRef="Gateway_HasProblems" targetRef="Gateway_MoreIssues" />
    <bpmn:sequenceFlow id="Flow_12" name="Нет" sourceRef="Gateway_MoreIssues" targetRef="Task_PrepareReport" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PrepareReport" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ShowIssueCard" targetRef="Task_CheckQuality" />
