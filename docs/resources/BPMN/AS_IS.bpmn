      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WriteComments" name="Зафиксировать замечания вручную">
      <bpmn:incoming>Flow_8_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MoreIssues" name="Есть еще задачи?">
