<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ToBe_JiraAnalyzer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.47.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_ToBe_JiraAnalyzer" name="TO-BE: Анализ задач через Jira Analyzer" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Jira" name="Jira">
        <bpmn:flowNodeRef>Task_ReturnIssues</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyzer" name="Jira Analyzer">
        <bpmn:flowNodeRef>Task_AnalyzeIssues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowAnalysisResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveEditedResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendJiraRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Task_ReviewResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenAnalyzer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetJql</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClickCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResultCorrect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoreResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Нужно проанализ-ть задачи Jira">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_OpenAnalyzer" name="Открыть Jira Analyzer">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_0q00f9e</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SetJql" name="Указать JQL для фильтрации задач">
      <bpmn:incoming>Flow_0q00f9e</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ClickCheck" name="Нажать кнопку проверки">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SendJiraRequest" name="Запросить задачи по JQL">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReturnIssues" name="Вернуть список задач">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_AnalyzeIssues" name="Проанализировать задачи через LLM">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ShowAnalysisResults" name="Показать результаты анализа">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ReviewResult" name="Проверить результат анализа задачи">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ResultCorrect" name="Результат корректен?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_13_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_EditResult" name="Отредактировать результат анализа">
      <bpmn:incoming>Flow_13_No</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_SaveEditedResult" name="Сохранить исправленный результат">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MoreResults" name="Есть еще результаты?">
      <bpmn:incoming>Flow_13_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_GenerateReport" name="Сформировать отчет">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ExportReport" name="Экспортировать отчет">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Отчет экспортирован">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_OpenAnalyzer" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_SetJql" targetRef="Task_ClickCheck" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendJiraRequest" targetRef="Task_ReturnIssues" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ReturnIssues" targetRef="Task_AnalyzeIssues" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_AnalyzeIssues" targetRef="Task_ShowAnalysisResults" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ShowAnalysisResults" targetRef="Task_ReviewResult" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ReviewResult" targetRef="Gateway_ResultCorrect" />
    <bpmn:sequenceFlow id="Flow_13_Yes" name="Да" sourceRef="Gateway_ResultCorrect" targetRef="Gateway_MoreResults" />
    <bpmn:sequenceFlow id="Flow_13_No" name="Нет" sourceRef="Gateway_ResultCorrect" targetRef="Task_EditResult" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_EditResult" targetRef="Task_SaveEditedResult" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SaveEditedResult" targetRef="Gateway_MoreResults" />
    <bpmn:sequenceFlow id="Flow_18" name="Да" sourceRef="Gateway_MoreResults" targetRef="Task_ReviewResult" />
    <bpmn:sequenceFlow id="Flow_16" name="Нет" sourceRef="Gateway_MoreResults" targetRef="Task_GenerateReport" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_GenerateReport" targetRef="Task_ExportReport" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_ExportReport" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_0q00f9e" sourceRef="Task_OpenAnalyzer" targetRef="Task_SetJql" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ClickCheck" targetRef="Task_SendJiraRequest" />
  </bpmn:process>
