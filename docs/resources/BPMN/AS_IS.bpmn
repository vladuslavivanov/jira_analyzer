        <bpmn:flowNodeRef>Gateway_0u94cxq</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1jotkzi" name="Jira">
        <bpmn:flowNodeRef>Task_ShowIssueList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowIssueCard</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_SetFilter" />
